# ============================================================
# SafeWork AI — Variables de entorno
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas .env al repositorio
# ============================================================

# --- General ---
NODE_ENV=development
APP_NAME=SafeWork AI
APP_URL=http://localhost:3000
LANDING_URL=http://localhost:4321

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://safework:password@localhost:5432/safework_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=safework_db
DATABASE_USER=safework
DATABASE_PASSWORD=changeme

# --- Redis (caché y sesiones) ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# --- Autenticación / JWT ---
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super-secret-refresh-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Cifrado E2E ---
ENCRYPTION_MASTER_KEY=32-byte-hex-key-change-in-production
ENCRYPTION_ALGORITHM=AES-256-GCM

# --- Python FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- AI Engine ---
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Java Case Management ---
CASE_MGMT_HOST=0.0.0.0
CASE_MGMT_PORT=8080

# --- Google Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@safework.es
SMTP_PASSWORD=changeme
SMTP_FROM=SafeWork AI <noreply@safework.es>

# --- Almacenamiento de archivos (S3-compatible) ---
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_BUCKET=safework-evidencias
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_REGION=eu-central-1

# --- Multi-tenant ---
TENANT_ISOLATION_MODE=schema
DEFAULT_TENANT_SCHEMA=public

# --- Monitoreo ---
SENTRY_DSN=https://...@sentry.io/...
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
