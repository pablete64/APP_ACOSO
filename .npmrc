# Este proyecto solo admite pnpm. Si intentas usar npm o yarn, aborta con error.
# Instalar pnpm: `corepack enable pnpm && corepack prepare pnpm@9.0.0 --activate`
only-allow=pnpm

# Cumplir estrictamente con el campo "engines" del package.json (Node 20+, pnpm 9+)
engine-strict=true

# pnpm: instalar peerDependencies automáticamente
auto-install-peers=true
