---
import { getCollection, getEntry } from "astro:content";
import Base from "@/layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(d: Date) {
  return d.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });
}
---

<Base title={`${post.data.title} — SafeWork AI`} description={post.data.description}>
  <main class="max-w-2xl mx-auto px-4 py-16">
    <a href="/blog" class="inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-700 mb-8 transition-colors">
      ← Volver al blog
    </a>

    <div class="flex flex-wrap gap-2 mb-4">
      {post.data.tags.map((tag) => (
        <span class="inline-block px-2 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 rounded-full">
          {tag}
        </span>
      ))}
    </div>

    <h1 class="text-3xl font-bold text-gray-900 mb-4 leading-tight">{post.data.title}</h1>

    <div class="flex items-center gap-4 text-sm text-gray-500 mb-10 pb-8 border-b border-gray-100">
      <span>{post.data.author}</span>
      <span>·</span>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    </div>

    <div class="prose prose-gray prose-lg max-w-none
      prose-headings:font-bold prose-headings:text-gray-900
      prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline
      prose-th:text-left prose-th:font-semibold
      prose-table:text-sm">
      <Content />
    </div>

    <div class="mt-16 p-6 bg-blue-50 rounded-2xl">
      <h2 class="text-lg font-bold text-gray-900 mb-2">¿Quieres ver SafeWork AI en acción?</h2>
      <p class="text-gray-600 text-sm mb-4">Demo gratuita de 30 minutos. Sin compromiso, sin tarjeta de crédito.</p>
      <a
        href="/demo"
        class="inline-block px-5 py-2.5 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors"
      >
        Solicitar demo
      </a>
    </div>
  </main>
</Base>
